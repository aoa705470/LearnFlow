# LearnFlow runs only on explicitly configured local entry points.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=mysql+pymysql://learnflow_dev:replace-with-a-local-password@127.0.0.1:3307/learnflow_dev?charset=utf8mb4
ALLOWED_HOSTS='["127.0.0.1:5173","127.0.0.1:8000"]'
ALLOWED_ORIGINS='["http://127.0.0.1:5173","http://127.0.0.1:8000"]'
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=30
DB_WRITE_TIMEOUT_SECONDS=30
DB_LOCK_WAIT_TIMEOUT_SECONDS=5

VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# Docker Compose uses separate credentials and named volumes for development and tests.
MYSQL_DEV_DATABASE=learnflow_dev
MYSQL_DEV_USER=learnflow_dev
MYSQL_DEV_PASSWORD=replace-with-a-local-password
MYSQL_DEV_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_TEST_DATABASE=learnflow_test
MYSQL_TEST_USER=learnflow_test
MYSQL_TEST_PASSWORD=replace-with-a-test-password
MYSQL_TEST_ROOT_PASSWORD=replace-with-a-different-test-root-password
